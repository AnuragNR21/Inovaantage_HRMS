# Application environment
NODE_ENV=development

# Oracle database connection
DB_USER=C##INOVAANTAGE
DB_PASSWORD=your_real_password
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE_NAME=orcl

# Optional: use this instead of DB_HOST/DB_PORT/DB_SERVICE_NAME
# DB_CONNECT_STRING=localhost:1521/orcl

# HTTP server and secure database-backed authentication
PORT=3000
SESSION_TTL_MINUTES=120
SESSION_ABSOLUTE_TTL_MINUTES=720
AUTH_BCRYPT_ROUNDS=12
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_ATTEMPT_WINDOW_MINUTES=15
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_LENGTH=72
AUTH_RESET_TOKEN_MINUTES=30
COOKIE_SECURE=false
APP_BASE_URL=http://localhost:3000
OPEN_BROWSER=false

# Salary workbook security and preview limits
PAYROLL_IMPORT_MAX_FILE_MB=10
PAYROLL_IMPORT_MAX_UNCOMPRESSED_MB=100
PAYROLL_IMPORT_MAX_ROWS=10000
PAYROLL_IMPORT_MAX_COLUMNS=100
PAYROLL_IMPORT_MAX_SHEETS=10
PAYROLL_IMPORT_PREVIEW_TTL_MINUTES=30
PAYROLL_IMPORT_PREVIEW_ROW_LIMIT=50
PAYROLL_IMPORT_DIAGNOSTIC_LIMIT=100
PAYROLL_MALWARE_SCAN_ENABLED=false
# Use clamdscan or clamscan. The command must be installed on the server.
PAYROLL_MALWARE_SCAN_COMMAND=clamdscan
PAYROLL_MALWARE_SCAN_TIMEOUT_MS=30000
# When true, uploads are rejected if the scanner cannot be run.
PAYROLL_MALWARE_SCAN_FAIL_CLOSED=true

# One-time first administrator bootstrap. Prefer process-level environment
# variables and remove them immediately after `npm run bootstrap-admin`.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator
ADMIN_EMAIL=

# Company details used in generated payslips and email text
COMPANY_NAME=INOVAANTAGE SYSTEMS PVT LTD
COMPANY_TAGLINE=Stay Digitally Ahead With Us
COMPANY_EMAIL=
COMPANY_WEBSITE=
COMPANY_LOCATION=Bengaluru, Karnataka, India
# Optional path to a PNG/JPEG logo. Relative paths resolve from the project root.
# The bundled INOVAANTAGE logo is used when this is left empty.
COMPANY_LOGO_PATH=

# Email notifications are disabled unless explicitly enabled.
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
