{
  "name": "inovaantage-payroll-portal",
  "version": "1.0.0",
  "description": "Employee Payroll Portal for Inovaantage Systems Pvt. Ltd. - plain HTML/CSS/JS frontend, Node.js backend, Oracle DB.",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "test": "node --test --test-concurrency=1",
    "test:unit": "node --test --test-concurrency=1 test/audit.unit.test.js test/http.test.js test/passwordService.test.js test/payrollEmail.unit.test.js test/payrollMalwareScan.unit.test.js test/rbac.unit.test.js test/security.test.js",
    "build": "node scripts/validate-build.js",
    "verify-email": "node scripts/verify-email.js",
    "migrate:auth": "node scripts/migrate-auth.js",
    "migrate:rbac": "node scripts/migrate-rbac.js",
    "migrate:data-isolation": "node scripts/migrate-data-isolation.js",
    "migrate:payroll-domain": "node scripts/migrate-payroll-domain.js",
    "migrate:payroll-import": "node scripts/migrate-payroll-import.js",
    "migrate:payslip-documents": "node scripts/migrate-payslip-documents.js",
    "migrate:payslip-email-jobs": "node scripts/migrate-payslip-email-jobs.js",
    "migrate:audit-logs": "node scripts/migrate-audit-logs.js",
    "migrate:payroll-hold": "node scripts/migrate-payroll-hold.js",
    "migrate:payroll-row-status": "node scripts/migrate-payroll-row-status.js",
    "migrate:multi-file-payroll": "node scripts/migrate-multi-file-payroll.js",
    "bootstrap-admin": "node scripts/bootstrap-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "formidable": "^2.1.5",
    "nodemailer": "^10.0.10",
    "oracledb": "^6.5.1",
    "pdfkit": "^0.15.0",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "UNLICENSED",
  "private": true
}
